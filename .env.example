# ============================================================
# QC Dashboard v1.1 — Конфигурация окружения
# Скопируйте этот файл: cp .env.example .env
# Никогда не коммитьте .env в git!
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=qc_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qc_dashboard

# --- Database Connection ---
DATABASE_URL=postgresql+psycopg2://qc_user:change_me@postgres:5432/qc_dashboard

# --- Reports Directory ---
REPORTS_SOURCE=./reports

# --- Backend API URL (используется auto_updater.py для upload файлов) ---
BACKEND_API_URL=http://backend:8000

# --- Режим данных ---
# "static" — фронтенд читает из assets/js/data.js (ТЕКУЩИЙ РАБОЧИЙ РЕЖИМ)
# "api"    — фронтенд читает из /api/metrics (ЦЕЛЕВОЙ РЕЖИМ после миграции фронтенда)
DATA_MODE=static

# --- Синхронизация с backend/PostgreSQL ---
# 1 = auto_updater.py ПАРАЛЛЕЛЬНО записывает данные в PostgreSQL
#     (рекомендуется держать включённым: данные накапливаются в БД,
#      что ускорит переход на DATA_MODE=api в будущем)
# 0 = только обновление data.js, без обращения к БД
ENABLE_BACKEND_SYNC=1